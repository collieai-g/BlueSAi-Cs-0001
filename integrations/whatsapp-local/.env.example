# Private loopback-only bridge. Copy outside Git and protect the directory ACL.
WA_LOCAL_DATA_DIR=
WA_LOCAL_PORT=3105
WA_LOCAL_INSTANCE=bluesai-local
# Blank generates bridge-api-key in the private data directory; never print it.
WA_LOCAL_API_KEY=
WA_LOCAL_WEBHOOK_URL=http://127.0.0.1:3100/webhooks/evolution
WA_LOCAL_WEBHOOK_SECRET=
# Stay closed on startup. The card can request a scoped per-process test session.
WA_LOCAL_DELIVERY_ENABLED=false
WA_LOCAL_ALLOW_TEST_ACTIVATION=true
# Empty permits QR and connection checks only; no received text is forwarded.
WA_LOCAL_TEST_RECIPIENTS=
