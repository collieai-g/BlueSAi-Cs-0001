# Copy to .env on the server. Never commit real secrets.
HOST=127.0.0.1
PORT=3100
# Default data location: ~/.blueprint-service (outside the repository).
BLUEPRINT_DATA_DIR=
# Optional: at least 32 characters. Otherwise generated in the data directory.
ADMIN_TOKEN=
COOKIE_SECURE=false

# Optional model API route; its billing is separate from ChatGPT sign-in.
# FAQ-only and the reviewed local native Codex route need no API key here.
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional trusted server-side Codex CLI executable path, never a shell command
# or a browser/customer-supplied value. Existing CLI ChatGPT auth stays in place.
# Connect/test from the card with owner consent; this alone enables no AI policy.
BLUESAI_CODEX_BIN=

# Evolution must be installed separately. Server-side credentials only.
EVOLUTION_URL=
EVOLUTION_INSTANCE=
EVOLUTION_API_KEY=
# At least 32 random characters; configure the same Bearer token in the webhook.
WEBHOOK_SECRET=
# Public HTTPS service origin used to register and verify the Evolution callback.
# Loopback HTTP is only for a provider on this same machine. No path/query.
PUBLIC_BASE_URL=
# Explicit send gate. Keep false until a test account passes acceptance checks.
DELIVERY_ENABLED=false
# Only for the reviewed loopback bridge. Owner must scan and explicitly consent
# to a test recipient in the card before the per-process test send gate opens.
LOCAL_WHATSAPP_TEST=false

# Separate customer web chat. Opening it does not enable WhatsApp sending.
WEB_CHAT_ENABLED=false
