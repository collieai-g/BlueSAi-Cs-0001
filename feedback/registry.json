        },
        {
          "id": "management-workspace",
          "classification": "process_gap",
          "disposition": "candidate_fix",
          "summary": "管理採五個持續可見分類與原位工作面；WhatsApp 四步可直選，安裝協助在目前渠道返回，保留現行表單及未儲存輸入。"
        },
        {
          "id": "ai-provider-selection",
          "classification": "process_gap",
          "disposition": "candidate_fix",
          "summary": "精簡 AI 接駁介面，選擇供應商及參考模型；未支援的供應商不得提交，指引草稿不含金鑰，不改已授權接駁。"
        },
        {
          "id": "empty-inbox-controls",
          "classification": "product_bug",
          "disposition": "candidate_fix",
          "summary": "空收件匣按真實收件狀態顯示下一步，人工及知識庫／AI 控制保持可見，未選對話時說明不可操作。"
        },
        {
          "id": "inbox-streamlined-controls",
          "classification": "process_gap",
          "disposition": "candidate_fix",
          "summary": "收件匣移除手動更新與人工接手／連線測試列表篩選及專用邏輯；保留自動同步、最後成功更新24小時時間及對話內人工控制。"
        },
        {
          "id": "conversation-context-details",
          "classification": "process_gap",
          "disposition": "candidate_fix",
          "summary": "以真實已有欄位整理對話、處理方式、回覆狀態與引用來源，未知欄位不虛構，桌面及手機詳情保持可操作。"
        },
        {
          "id": "dedicated-card-target",
          "classification": "integration_gap",
          "disposition": "candidate_fix",
          "summary": "原生 renderer 只掛入宿主專用卡片容器，缺少合約時明確拒絕；登記時序、同一草稿 DOM 與帳戶隔離用合成案例驗證。"
        },
        {
          "id": "complete-generated-source-pin",
          "classification": "product_bug",
          "disposition": "candidate_fix",
          "summary": "宿主產物版本核對包括實際設計、元件、模板及產生程式；只改模板或產生器不可沿用舊 commit 的已核對標示。"
        },
        {
          "id": "compact-card-proportions",
          "classification": "process_gap",
          "disposition": "candidate_fix",
          "summary": "客服工作區的文字、控制項、對話泡泡及回覆框比例過大；在同一設計來源精簡尺寸與留白，按可用卡片空間排版，保留配色、人工／AI 控制、詳情與未送出輸入，不以整頁 zoom 或 transform 縮放。"
        },
        {
          "id": "reference-entry-preserved",
          "classification": "process_gap",
          "disposition": "candidate_fix",
          "summary": "Agent 工作台首頁以已批准的原生客服入口取代通用摘要卡，保留圖示、名稱、編號、管理、真實 WhatsApp 狀態及開啟收件匣；首頁與展開沿用同一客服根節點及對話草稿，只調整呈現比例，不硬編碼已接駁或搬入參考圖片的私人資料。"
        },
        {
          "id": "persistent-inbox-management-panes",
          "classification": "product_bug",
          "disposition": "candidate_fix",
          "summary": "卡片縮窄時舊手機模式會隱藏對話區或對話內容，管理分類亦改變位置及隱藏副文字。本輪按已批准尺寸合約保留同一卡片內的客戶諮詢區、對話及管理分類，依可用空間調整欄寬、換行與區內捲動，不以尺寸斷點取消主要工作區。"
        },
        {
          "id": "container-owned-workspace-height",
          "classification": "product_bug",
          "disposition": "candidate_fix",
          "summary": "工作區高度原依瀏覽器視窗計算，與實際宿主卡片尺寸脫節；改由同一卡片外框分配頂列、分頁、內容及頁尾高度，三個主要檢視共用尺寸，長內容在各自區域捲動並保留可到達的回覆欄及操作。"
        },
        {
          "id": "four-three-card-sizing",
          "classification": "process_gap",
          "disposition": "candidate_fix",
          "summary": "同一張客服卡片沿已批准的 4:3 外框比例縮放，尺寸來源、最小／預設／最大範圍及窄畫面處理與原生宿主合約一致；保留現行配色、可閱讀文字與未儲存輸入，不使用整頁 zoom 或 transform 縮放代替排版。"
        },
        {
          "id": "generated-checkout-newlines",
          "classification": "client_compatibility_gap",
          "disposition": "candidate_fix",
          "summary": "Windows Git 簽出可能把來源及生成資產轉成 CRLF；生成內容驗收沿用 Python 的換行正規化，同時保留 HTML 與 CSS 完整內容相等及資產邊界斷言。"
        }
      ],
